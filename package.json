{
  "name": "chofex-hackathon",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "deploy:apply": "bun scripts/deploy.ts apply",
    "deploy:plan": "bun scripts/deploy.ts plan",
    "deploy:status": "bun scripts/deploy.ts status",
    "dev": "turbo run dev",
    "lint": "bun --filter chofex-cli check-examples && turbo run lint",
    "format": "biome format --write .",
    "check-types": "turbo run check-types",
    "deck:pdf": "node scripts/export-deck-pdf.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "husky": "^9.1.7",
    "playwright": "^1.63.0",
    "turbo": "^2.10.12",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "esbuild": "0.28.2",
    "image-size": "2.0.4",
    "tar": "7.5.22",
    "ws": "8.21.3",
    "@modelcontextprotocol/sdk": "1.32.1",
    "brace-expansion": "5.0.12",
    "dompurify": "3.4.16",
    "fast-uri": "3.1.8",
    "ip-address": "10.7.3",
    "proxy-addr": "2.0.8",
    "source-map-js": "1.2.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "patchedDependencies": {
    "braces@3.0.3": "patches/braces@3.0.3.patch",
    "sprintf-js@1.0.3": "patches/sprintf-js@1.0.3.patch"
  }
}
